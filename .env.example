# Inkloom Guard Environment Configuration Template
# COPY TO .env.local OR .env AND FILL WITH YOUR SECRETS (NEVER COMMIT ACTUAL SECRETS)

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000

# Backend Configuration
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=inkloom_guard
DATABASE_URL=postgresql://postgres:your_secure_postgres_password_here@localhost:5432/inkloom_guard

# Vector DB (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Object Store (MinIO / S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Foundation Model (Google Gemini)
# Leave empty to run in deterministic offline mode
GEMINI_API_KEY=
AI_MODEL_NAME=Gemini-2.5-Pro
